import type {Config,Context} from '@netlify/functions';
import OpenAI from 'openai';
import {and,eq} from 'drizzle-orm';
import {db} from '../../db/index.js';
import {liveModerators,liveRooms} from '../../db/schema.js';
import {assertSameOrigin,memberJSON,MemberError} from './_shared/member-auth.mts';
import {resolveCommunityProfileMember} from './_shared/roster-access.mts';
import {monaStore} from './_shared/mona-workspace.mts';
import {getMonaBookings} from './_shared/mona-booking-summary.mts';
import {cleanChatText,conversationInstructions,fallbackAnswer,ndjson,readHistory,safeRoute,sourceUrls,validateGroundedAnswer} from './_shared/mona-conversation.mts';
import {normalizeRoomKey} from './_shared/roster-live.mts';

async function smallBody(req:Request){if(!req.headers.get('content-type')?.toLowerCase().startsWith('application/json'))throw new MemberError(415,'Send MONA a text request.');if(Number(req.headers.get('content-length')||0)>16000)throw new MemberError(413,'This conversation is too large.');const value=await req.json().catch(()=>null);if(!value||typeof value!=='object'||Array.isArray(value))throw new MemberError(400,'Ask MONA one clear question.');return value as any}
async function liveContext(keyValue:unknown,memberId:string){if(typeof keyValue!=='string'||!keyValue)return null;let key:string;try{key=normalizeRoomKey(keyValue)}catch{return null}const [room]=await db.select({id:liveRooms.id,title:liveRooms.title,hostId:liveRooms.hostId,status:liveRooms.status}).from(liveRooms).where(and(eq(liveRooms.roomKey,key),eq(liveRooms.status,'live'))).limit(1);if(!room)return null;const host=room.hostId===memberId;const [mod]=host?[]:await db.select({id:liveModerators.id}).from(liveModerators).where(and(eq(liveModerators.roomId,room.id),eq(liveModerators.memberId,memberId),eq(liveModerators.active,true))).limit(1);return{title:room.title,role:host?'host':mod?'moderator':'viewer',private_host_cues_allowed:host}}
export default async function(req:Request,context:Context):Promise<Response>{let member:any=null;let grounded:any[]=[];try{if(req.method!=='POST')throw new MemberError(405,'Ask MONA from the assistant panel.');assertSameOrigin(req);member=await resolveCommunityProfileMember();const input=await smallBody(req),message=cleanChatText(input.message),history=readHistory(input.history),route=safeRoute(input.route||input.surface);const store=monaStore(context);const workspace=await store.get(`workspaces/${member.id.toLowerCase()}`,{type:'json'}).catch(()=>null);grounded=workspace?.memberId===member.id.toLowerCase()&&Array.isArray(workspace.leads)?workspace.leads.filter((lead:any)=>{try{const u=new URL(lead.sourceUrl);return ['http:','https:'].includes(u.protocol)&&!!lead.checkedAt}catch{return false}}).slice(0,12):[];const bookingReq=new Request(new URL('/api/mona/bookings',req.url),{method:'GET',headers:req.headers});const [bookingResponse,live]=await Promise.all([getMonaBookings(bookingReq).catch(()=>null),liveContext(input.live_room_key,member.id)]);const booking=bookingResponse?.ok?await bookingResponse.json():null;const boundedContext={member:{id:member.id,name:member.name},route,current_surface:route,manual_location:workspace?.preferences?.location||'',preferences:workspace?.preferences||null,grounded_leads:grounded.map((lead:any)=>({title:String(lead.title||'').slice(0,120),organization:String(lead.organization||'').slice(0,100),location:String(lead.location||'').slice(0,120),whyItFits:String(lead.whyItFits||'').slice(0,240),nextStep:String(lead.nextStep||'').slice(0,240),confidence:lead.confidence||'source-grounded',sourceUrl:lead.sourceUrl,checkedAt:lead.checkedAt,deadline:lead.deadline||null})),booking:booking?{upcoming:booking.upcoming?.slice(0,8)||[],upcomingCount:booking.upcomingCount||0,pendingCount:booking.pendingCount||0,businesses:booking.businesses?.map((b:any)=>({name:b.name,published:b.published,activeServiceCount:b.activeServiceCount}))?.slice(0,6)||[]}:null,live};const allowed=sourceUrls({leads:grounded});let answer:string;try{const ai=new OpenAI({timeout:22_000,maxRetries:0});const abort=AbortSignal.timeout(24000);const response=await ai.responses.create({model:'gpt-5.6-sol',max_output_tokens:900,instructions:conversationInstructions(),input:JSON.stringify({authenticated_context:boundedContext,conversation:history,user_request:message}),text:{format:{type:'json_schema',name:'mona_answer',strict:true,schema:{type:'object',additionalProperties:false,required:['answer','citedSourceUrls'],properties:{answer:{type:'string',maxLength:5000},citedSourceUrls:{type:'array',maxItems:12,items:{type:'string'}}}}}}} as any,{signal:abort});answer=validateGroundedAnswer(JSON.parse(response.output_text||'{}'),allowed)}catch{answer=fallbackAnswer(grounded.length>0)}const requestId=context.requestId||crypto.randomUUID();const encoder=new TextEncoder();const stream=new ReadableStream({start(controller){controller.enqueue(encoder.encode(ndjson('meta',{requestId,model:'gpt-5.6-sol',updatedAt:new Date().toISOString()})));const chunks=answer.match(/.{1,42}(?:\s|$)|.{1,42}/g)||[answer];for(const text of chunks)controller.enqueue(encoder.encode(ndjson('delta',{text})));controller.enqueue(encoder.encode(ndjson('done',{requestId})));controller.close()}});return new Response(stream,{headers:{'Content-Type':'application/x-ndjson; charset=utf-8','Cache-Control':'private, no-store','Netlify-CDN-Cache-Control':'no-store','X-Content-Type-Options':'nosniff','X-Request-ID':requestId,'Vary':'Cookie, Authorization'}})}catch(error){const status=error instanceof MemberError?error.status:503;return memberJSON({error:error instanceof MemberError?error.message:'MONA could not connect. Nothing was changed.'},status)}}
export const config:Config={path:'/api/mona/chat',method:'POST',rateLimit:{windowLimit:12,windowSize:3600,aggregateBy:['ip','domain']}};
